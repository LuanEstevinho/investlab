{
  "name": "@investlab/ms-ativos",
  "version": "2.0.0",
  "description": "Microserviço de Ativos (FIIs, ações e renda fixa) - MongoDB Atlas",
  "type": "module",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:arch": "vitest run test/arquitetura.test.ts"
  },
  "dependencies": {
    "@azure/service-bus": "^7.10.0",
    "express": "^5.1.0",
    "mongodb": "^6.17.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsarch": "^5.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
